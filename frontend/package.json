{
  "name": "floorplan-ui",
  "version": "0.2.0-beta.3",
  "description": "Floorplan editor for Home Assistant",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "schema:generate": "json2ts -i ../schema/floorplan-config.schema.json -o src/types/floorplan-config.generated.ts --maxItems -1 --bannerComment '/* AUTO-GENERATED from schema/floorplan-config.schema.json. DO NOT EDIT. */'",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "konva": "^9.3.6",
    "lit": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.54.2",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^3.2.4"
  }
}
