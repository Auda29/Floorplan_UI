# skills.allowlist

# This file governs which external skill sources are permitted in this project.
# It helps prevent supply chain attacks by restricting where skills can be fetched from.
#
# Format:
# - Lines starting with '#' are comments.
# - Each line should contain a trusted source URL or identifier.
#
# Example:
#
# allowed_sources:
#   - "github.com/anthropic"
#   - "github.com/cursor-dev"
#
# blocked_sources:
#   - "github.com/untrusted-source"

allowed_sources:

blocked_sources:
